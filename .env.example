# Copy to .env and adjust. All values have working local defaults.

# Infrastructure
QDRANT_URL=http://localhost:6333
TEI_URL=http://localhost:8080
COLLECTION=laila_knowledge

# Retrieval service
PORT=8090
# Bearer token for /v1/* (doc 08 §5, docs/10). Empty = auth off (local dev only).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Give the same value to callers (Druid, scripts, sandbox console) — they send
# `Authorization: Bearer <token>`. Local scripts read it from this file automatically.
SERVICE_TOKEN=

# Retrieval defaults
TOP_K=5

# Query-time dependency timeouts, ms (doc 06 §7) — a hung TEI/Qdrant fails fast to a 503
# {error:"dependency_unavailable"} so Druid falls back instead of hanging (doc 08 §5).
# Ingestion keeps its own larger embed ceiling (src/lib/embedder.js).
EMBED_TIMEOUT_MS=10000
QDRANT_TIMEOUT_MS=10000

# Routing thresholds (doc 06 §5 / D7) — cosine-similarity scale, dense-only routing search.
# Start conservative (favor clarifying); calibrate with `npm run eval:sweep` (doc 09 §4).
ROUTE_TAU_HIGH=0.80
ROUTE_TAU_LOW=0.60
ROUTE_MARGIN=0.05

# Generation LLM (docs/15 §6) — ANY OpenAI-compatible endpoint. Empty = /v1/answer returns 503
# and query rewriting (docs/12) passes through; /v1/retrieve + /v1/route work fine without it.
#   Ollama local : LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:3b-instruct
#                  (avoid thinking models like qwen3 — reasoning burns the token budget
#                  even with /no_think; see scripts/probe-llm.js)
#   OpenAI       : LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4.1-mini  LLM_API_KEY=sk-…
#   Gemini compat: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional different model for the docs/12 follow-up rewrite call only. Leave empty =
# use LLM_MODEL. Probed 2026-07-16: qwen2.5:7b is WORSE than 3b here (drifts to
# Chinese/English) — the fix was language-matched examples, not a bigger model.
LLM_REWRITE_MODEL=

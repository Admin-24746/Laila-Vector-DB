node_modules/
.env
.ingest-state.json
logs/
eval/runs/
.claude/

# Qdrant's NATIVE default storage path when qdrant.exe is launched from the repo root.
# NOTE: this is ./storage, NOT ./qdrant_storage. The old qdrant_storage/ was a stale
# 2026-08-11 database that had been committed to git; it was read by nothing and deleted
# on 2026-09-10. Both names are ignored so neither DB is ever committed again.
storage/
qdrant_storage/

# Obsidian's per-machine state, created when the vault/ folder is opened in the app.
# workspace.json changes on every pane move, so committing it means noise in every diff.
# The NOTES are the vault; this folder is just one machine's window layout and plugin toggles.
vault/.obsidian/
